{
  "Database": {
    "MySqlVersion": "8.0.36"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=pcp.db"
  },
  "Files": {
    "MaxUploadMb": 200
  },
  "Wol": {
    "Enabled": true,
    "CooldownSeconds": 20,
    "Port": 9,
    "DirectSendEnabled": false,
    "PreferredRelayScreenId": ""
  },
  "Scheduling": {
    "Enabled": true,
    "TimeZone": "Europe/Madrid",
    "TickSeconds": 20,
    "LeadSeconds": 10
  },
  "Projector": {
    "Enabled": true,
    "PathPrefix": "pcp",
    "PublicWhipBaseUrl": "http://localhost:8889",
    "PublicHlsBaseUrl": "http://localhost:8888",
    "PublicRtspUrl": "rtsp://localhost:8554",
    "ReadUser": "pcp",
    "AuthKey": "",
    "PublisherGraceSeconds": 300,
    "SessionMaxHours": 12,
    "BufferMs": 400,
    "Volume": 80,
    "HealthCheckEnabled": true,
    "HealthCheckTimeoutSeconds": 4,
    "HealthCheckCacheSeconds": 5,
    "HealthCheckRtsp": true,
    "HealthCheckIntervalSeconds": 20,
    "HealthCheckFailuresBeforeClose": 2
  },
  "Auth": {
    "Issuer": "pcp",
    "Audience": "pcp-panel",
    "UserTokenMinutes": 480,
    "AgentTokenDays": 30,
    "CookieName": "pcp_auth",
    "CookieSameSite": "Lax",
    "AdminUsername": "admin",
    "AllowLegacyAgentTokens": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pcp.Server": "Debug"
    }
  },
  "AllowedHosts": "*"
}
