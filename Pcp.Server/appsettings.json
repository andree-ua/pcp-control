{
  "Database": {
    "MySqlVersion": "8.0.36"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=pcp.db"
  },
  "Files": {
    "MaxUploadMb": 200
  },
  "Wol": {
    "Enabled": true,
    "CooldownSeconds": 20,
    "Port": 9,
    "DirectSendEnabled": false,
    "PreferredRelayScreenId": ""
  },
  "Auth": {
    "Issuer": "pcp",
    "Audience": "pcp-panel",
    "UserTokenMinutes": 480,
    "AgentTokenDays": 30,
    "CookieName": "pcp_auth",
    "CookieSameSite": "Lax",
    "AdminUsername": "admin",
    "AllowLegacyAgentTokens": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pcp.Server": "Debug"
    }
  },
  "AllowedHosts": "*"
}
