{
  "Agent": {
    "ScreenId": "screen-01",
    "Name": "Pantalla 01 (Sala Principal)",
    "Token": "dev-token",
    "ServerUrl": "http://localhost:5000",
    "DevMode": true,
    "AllowSystemCommands": true,
    "SystemCommandDelaySeconds": 5,
    "FileRoots": [],
    "ProtectedPaths": [
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "C:\\ProgramData",
      "C:\\$Recycle.Bin",
      "C:\\System Volume Information",
      "C:\\Recovery",
      "C:\\Boot",
      "C:\\PerfLogs",
      "C:\\pagefile.sys",
      "C:\\hiberfil.sys",
      "C:\\swapfile.sys"
    ],
    "MaxUploadMb": 200,
    "LogPath": "",
    "Kiosk": {
      "TopMostOnlyWhilePlaying": true,
      "IdleWindowState": "Maximized"
    },
    "Vnc": {
      "Enabled": true,
      "ForceApplicationMode": true,
      "ExecutablePath": "",
      "PackagePath": "",
      "InstallDir": "",
      "StartupTimeoutSeconds": 12,
      "Args": []
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.SignalR.Client": "Warning"
    }
  }
}
