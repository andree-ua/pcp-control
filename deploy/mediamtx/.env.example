# Copia este archivo a .env y ajusta los valores antes de `docker compose up`.
# En Oracle Cloud, setup-oracle-cloud.sh genera el .env automáticamente.

# Versión fijada de MediaMTX (reproducible). Ver releases del proyecto.
MEDIAMTX_VERSION=1.21.4

# URL del Pcp.Server que valida cada publicación/lectura.
# Cloud: https://TU-SERVICIO.onrender.com/api/projector/auth
# Si defines Projector__AuthKey en Render, añade ?key=TU_CLAVE al final.
PCP_AUTH_URL=http://host.docker.internal:5000/api/projector/auth

# IP pública (o host resoluble) que se anuncia al navegador por WebRTC.
# En local puedes dejar 127.0.0.1; en cloud es OBLIGATORIA la IP pública.
PUBLIC_HOST=127.0.0.1

# En cloud pon false para no anunciar la IP privada 10.x de la instancia.
WEBRTC_IPS_FROM_INTERFACES=true

# error | warn | info | debug
MTX_LOGLEVEL=info

# Dominio con HTTPS para el WHIP (solo docker compose -f docker-compose.tls.yml).
# Ejemplo: pcp-media.duckdns.org
# PCP_DOMAIN=pcp-media.duckdns.org
