# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para producción (servidor + agente)
# Copiar/adaptar en el panel de Aiven/Clever Cloud o en el instalador del stick.
# NO versionar valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor (Pcp.Server) ────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# Cadena de conexión MySQL. Se acepta la URI que entrega el proveedor…
DATABASE_URL=mysql://usuario:password@host:3306/pcp?ssl-mode=REQUIRED
# …o una cadena ADO.NET estándar:
# ConnectionStrings__MySql=Server=host;Port=3306;Database=pcp;User ID=usuario;Password=password;SslMode=Required;

# Orígenes permitidos para el panel (repetir el índice 0,1,2…)
Cors__AllowedOrigins__0=https://panel.example.com

# Puerto asignado por la nube (si no se define, se usa ASPNETCORE_URLS)
PORT=8080

# Límite de subida de archivos en MB (opcional)
Files__MaxUploadMb=200

# ── Wake-on-LAN (opcional) ───────────────────────────────────────────────────
# Cooldown por pantalla para evitar ráfagas de Magic Packets.
Wol__CooldownSeconds=20
# Envío directo desde el servidor: solo si el servidor comparte LAN con los
# sticks (on-prem). En Render debe quedar en false: el paquete lo emite un
# agente online de la misma red (relay).
Wol__DirectSendEnabled=false
# Relay preferido (opcional). Si está vacío se elige el agente online cableado
# más reciente de la misma subred.
# Wol__PreferredRelayScreenId=

# ── Autenticación JWT (Fase 3) ───────────────────────────────────────────────
# Clave de firma de al menos 32 caracteres. OBLIGATORIA en producción:
# si falta, el servidor no arranca. Generar una aleatoria y custodiarla.
Auth__SigningKey=cambiar-por-una-clave-aleatoria-de-32-o-mas-caracteres

# Administrador inicial. Solo se usa si la tabla Users está vacía.
# En producción la contraseña es obligatoria para poder entrar la primera vez.
Auth__AdminUsername=admin
Auth__AdminPassword=cambiar-en-produccion

# Cookies del panel: SameSite=None exige HTTPS y es necesario si el panel
# y la API viven en dominios distintos.
Auth__CookieSameSite=None

# Emisor/audiencia y duración de los tokens (opcional)
Auth__Issuer=pcp
Auth__Audience=pcp-panel
Auth__UserTokenMinutes=480
Auth__AgentTokenDays=30

# Compatibilidad temporal con agentes Fase 1/2 que usan ?screenId&token en el Hub.
# Dejar en true durante la actualización escalonada; poner false cuando todos los
# agentes publicados ya obtengan JWT en /api/auth/agent-token.
Auth__AllowLegacyAgentTokens=true

# ── Agente (Pcp.Agent) ──────────────────────────────────────────────────────
# Los atajos PCP_SERVER_URL / PCP_SCREEN_ID / PCP_TOKEN son los más cómodos
# para el instalador. También se aceptan PCP_Agent__ServerUrl, etc.
PCP_SERVER_URL=https://api.example.com
PCP_SCREEN_ID=screen-01
PCP_SCREEN_NAME=Pantalla 01
PCP_TOKEN=cambiar-en-produccion
PCP_Agent__DevMode=false
PCP_Agent__AllowSystemCommands=true

# Wake-on-LAN: normalmente la detección es automática. Estos overrides solo son
# necesarios si el stick tiene un adaptador con nombre/descripción atípicos
# (o si se prueba dentro de una VM, cuyo NIC es virtual a propósito).
# PCP_Agent__Wol__InterfaceName=Ethernet
# PCP_Agent__Wol__MacOverride=AA:BB:CC:DD:EE:FF
